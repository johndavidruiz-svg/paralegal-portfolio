---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TaskCard from '@/components/task/TaskCard.astro';
import ArtifactCrossRef from '@/components/task/ArtifactCrossRef.astro';
import Callout from '@/components/ui/Callout.astro';

export async function getStaticPaths() {
  const tasks = await getCollection('tasks');
  const artifacts = await getCollection('artifacts');
  return tasks.map((t) => ({
    params: { slug: t.data.slug },
    props: {
      taskEntry: t,
      artifacts: artifacts.filter((a) => a.data.taskTypeSlug === t.data.slug),
    },
  }));
}

const { taskEntry, artifacts } = Astro.props;
const { Content } = await taskEntry.render();
const d = taskEntry.data;
---
<BaseLayout title={`${d.name} — Task Type`} description={d.shortDef}>
  <TaskCard name={d.name} stage={d.stage} shortDef={d.shortDef} />

  <article class="mx-auto max-w-3xl px-6 py-10 prose prose-neutral">
    <h2>When it's used</h2>
    <p>{d.whenUsed}</p>

    {d.caJurisdictionNotes && (
      <Callout tone="info" title="California-specific notes">
        {d.caJurisdictionNotes}
      </Callout>
    )}

    <h2>Definition</h2>
    <Content />

    <h2 class="mt-12">Examples in this portfolio</h2>
    <ArtifactCrossRef artifacts={artifacts} />
  </article>
</BaseLayout>
