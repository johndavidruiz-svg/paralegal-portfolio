---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Paralegal Portfolio">
  <section class="px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs uppercase tracking-[0.2em] text-accent font-semibold">Contact</p>
      <h1 class="font-display text-4xl md:text-5xl mt-4">Get in touch</h1>
      <p class="text-muted mt-6 text-lg">
        For inquiries about AI-augmented paralegal support, hiring, or the work shown here.
      </p>

      <div class="mt-10 flex flex-col gap-4 items-center">
        <a
          href="https://mail.google.com/mail/?view=cm&fs=1&to=john.david.ruiz@gmail.com&su=Inquiry%20%E2%80%94%20AI%20Paralegal%20Portfolio&body=Hi%20John%20David%2C%0A%0AI%20found%20your%20AI-augmented%20paralegal%20portfolio%20and%20wanted%20to%20reach%20out%20about%3A%0A%0A%0A%0AThanks%2C%0A"
          target="_blank"
          rel="noopener"
          class="inline-block bg-ink text-paper px-8 py-4 rounded-full font-semibold hover:bg-accent transition cursor-pointer"
        >
          john.david.ruiz@gmail.com
        </a>
      </div>

      <p class="text-xs text-muted mt-12">
        No contact form by design — direct email keeps the loop tight.
      </p>
    </div>
  </section>
</BaseLayout>
