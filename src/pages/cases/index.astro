---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseTile from '@/components/case/CaseTile.astro';

const cases = await getCollection('cases');
const artifacts = await getCollection('artifacts');
---
<BaseLayout title="Cases — Paralegal Portfolio">
  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs uppercase tracking-[0.2em] text-accent font-semibold">Cases</p>
      <h1 class="font-display text-4xl md:text-5xl mt-4 mb-10">Six fictional California matters</h1>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((c) => (
          <CaseTile
            href={`/cases/${c.data.slug}/`}
            caption={c.data.caption}
            practiceArea={c.data.practiceArea}
            oneLiner={c.data.oneLiner}
            artifactCount={artifacts.filter((a) => a.data.caseSlug === c.data.slug).length}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
