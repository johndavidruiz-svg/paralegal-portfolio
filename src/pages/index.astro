---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseTile from '@/components/case/CaseTile.astro';
import TaskChip from '@/components/task/TaskChip.astro';
import Stat from '@/components/ui/Stat.astro';
import RuleHairline from '@/components/ui/RuleHairline.astro';

const cases = await getCollection('cases');
const tasks = await getCollection('tasks');
const artifacts = await getCollection('artifacts');

const caseTiles = cases.map((c) => ({
  ...c.data,
  href: `/cases/${c.slug}/`,
  artifactCount: artifacts.filter((a) => a.data.caseSlug === c.slug).length,
}));
---
<BaseLayout title="AI-Augmented Paralegal Portfolio — 29 task types, 7 fictional cases">
  <section class="px-6 py-20 md:py-28 relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(230,57,70,0.08),transparent_60%)]"></div>

    <div class="relative mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 bg-ink text-paper text-[11px] uppercase tracking-[0.18em] font-semibold px-3.5 py-1.5 rounded-full shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        Built with Claude AI · 100% disclosed
      </div>

      <p class="text-xs uppercase tracking-[0.2em] text-accent font-semibold mt-5">AI-Augmented Paralegal · California Jurisdiction</p>

      <h1 class="font-display text-5xl md:text-7xl mt-4 leading-tight">
        Every paralegal task,<br />delivered with an<br /><span class="text-accent">AI workflow</span>.
      </h1>
      <p class="text-muted mt-6 text-lg max-w-2xl mx-auto">
        Intake to trial — 29 task types, each shown through an AI-assisted artifact with prompts, edits,
        and reviewer notes disclosed. Seven fictional California cases. No real client data.
      </p>

      <div class="mt-8 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs font-mono text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="text-accent">▸</span> Prompt log</span>
        <span class="hidden sm:inline text-rule/30">·</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-accent">▸</span> Reviewer edits</span>
        <span class="hidden sm:inline text-rule/30">·</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-accent">▸</span> Accuracy notes</span>
        <span class="hidden sm:inline text-rule/30">·</span>
        <span class="inline-flex items-center gap-1.5"><span class="text-accent">▸</span> Hallucination check</span>
      </div>
    </div>

    <div class="relative mx-auto max-w-3xl mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
      <Stat value="29" label="Task types" />
      <Stat value="7" label="Fictional cases" />
      <Stat value="29" label="AI-drafted artifacts" />
      <Stat value="CA" label="Jurisdiction" />
    </div>
  </section>

  <RuleHairline tone="accent" />

  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-3xl md:text-4xl mb-8">The cases</h2>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {caseTiles.map((c) => (
          <CaseTile
            href={c.href}
            caption={c.caption}
            practiceArea={c.practiceArea}
            oneLiner={c.oneLiner}
            artifactCount={c.artifactCount}
          />
        ))}
      </div>
    </div>
  </section>

  <RuleHairline />

  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-3xl md:text-4xl mb-8">The 29 task types</h2>
      <div class="flex flex-wrap gap-2">
        {tasks.sort((a,b) => a.data.name.localeCompare(b.data.name)).map((t) => (
          <TaskChip href={`/tasks/${t.slug}/`} name={t.data.name} shortDef={t.data.shortDef} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
