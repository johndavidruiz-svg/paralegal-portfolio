---
interface Props {
  timeline: { date: string; event: string }[];
}
const { timeline } = Astro.props;
---
<ol class="relative border-l-2 border-accent/30 ml-3 space-y-6 my-8">
  {timeline.map(({ date, event }) => (
    <li class="ml-6">
      <span class="absolute -left-[7px] w-3 h-3 bg-accent rounded-full mt-1.5"></span>
      <p class="text-xs uppercase tracking-wider text-muted font-mono">{date}</p>
      <p class="text-base mt-1">{event}</p>
    </li>
  ))}
</ol>
