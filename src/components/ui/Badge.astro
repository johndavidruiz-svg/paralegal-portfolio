---
interface Props {
  tone?: 'accent' | 'accent-2' | 'accent-3' | 'ink';
}
const { tone = 'accent' } = Astro.props;
const map = {
  accent: 'bg-accent text-paper',
  'accent-2': 'bg-accent-2 text-paper',
  'accent-3': 'bg-accent-3 text-ink',
  ink: 'bg-ink text-paper',
};
---
<span class={`inline-block px-2.5 py-1 rounded text-[11px] font-semibold tracking-wider uppercase ${map[tone]}`}>
  <slot />
</span>
