---
const links = [
  { href: '/cases', label: 'Cases' },
  { href: '/tasks', label: 'Tasks' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<nav class="sticky top-0 z-30 border-b border-rule/10 bg-paper/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-xl font-bold tracking-tight">
      Paralegal Portfolio<span class="text-accent">.</span>
    </a>
    <ul class="flex gap-6 text-sm">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-accent transition">{label}</a></li>
      ))}
    </ul>
  </div>
</nav>
