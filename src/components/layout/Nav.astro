---
const links = [
  { href: '/cases', label: 'Cases' },
  { href: '/tasks', label: 'Tasks' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<nav class="sticky top-0 z-30 border-b border-rule/10 bg-paper/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 group">
      <span class="font-display text-xl font-bold tracking-tight leading-none">
        AI Paralegal<span class="text-accent">.</span>
      </span>
      <span class="hidden sm:inline-flex items-center gap-1.5 bg-ink text-paper text-[10px] uppercase tracking-[0.14em] font-semibold px-2 py-1 rounded-full">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-accent"></span>
        </span>
        AI Specialist
      </span>
    </a>
    <ul class="flex gap-6 text-sm">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-accent transition">{label}</a></li>
      ))}
    </ul>
  </div>
</nav>
