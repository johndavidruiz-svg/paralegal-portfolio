---
interface Props {
  documentType: string;
}
const { documentType } = Astro.props;
const usePleading = documentType === 'pleading' || documentType === 'motion';
---
<div class="word-doc-shell">
  <article class={`word-doc-page ${usePleading ? 'pleading-paper' : ''}`}>
    <slot />
  </article>
</div>
