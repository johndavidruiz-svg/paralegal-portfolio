---
interface Props {
  href: string;
  name: string;
  shortDef?: string;
}
const { href, name, shortDef } = Astro.props;
---
<a href={href} class="group inline-block border border-rule/15 rounded-full px-4 py-2 text-sm hover:border-accent hover:bg-accent hover:text-paper transition">
  {name}
  {shortDef && <span class="sr-only"> — {shortDef}</span>}
</a>
