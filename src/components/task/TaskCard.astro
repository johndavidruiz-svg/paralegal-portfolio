---
import Badge from '@/components/ui/Badge.astro';
interface Props {
  name: string;
  stage: string;
  shortDef: string;
}
const { name, stage, shortDef } = Astro.props;
const stageLabel = stage.replace(/-/g, ' ');
---
<header class="bg-ink text-paper px-6 py-12">
  <div class="mx-auto max-w-4xl">
    <Badge tone="accent">{stageLabel}</Badge>
    <h1 class="font-display text-4xl md:text-5xl mt-4">{name}</h1>
    <p class="text-paper/80 mt-4 text-lg max-w-prose">{shortDef}</p>
  </div>
</header>
